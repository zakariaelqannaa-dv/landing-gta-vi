---
import PS5 from "@/assets/ps5.svg"
import Xbox from "@/assets/xbox.svg"

// Announced launch date for Grand Theft Auto VI (Rockstar Games).
// Kept as constants so the countdown is easy to update in one place.
const RELEASE_DATE = "2026-11-19T00:00:00-05:00"
const RELEASE_LABEL = "November 19, 2026"

const platforms = [
  { name: "PlayStation 5", Icon: PS5 },
  { name: "Xbox Series X|S", Icon: Xbox },
]

const units = [
  { id: "countdown-days", label: "Days" },
  { id: "countdown-hours", label: "Hours" },
  { id: "countdown-minutes", label: "Minutes" },
  { id: "countdown-seconds", label: "Seconds" },
]
---

<section
  id="release"
  aria-labelledby="release-title"
  class="border-t border-white/10"
>
  <div
    class="mx-auto grid w-full max-w-5xl gap-14 px-6 py-20 sm:py-28 lg:grid-cols-2 lg:gap-20"
  >
    <div>
      <p class="text-xs font-semibold tracking-[0.3em] text-pink-300 uppercase">
        Release
      </p>
      <h2
        id="release-title"
        class="mt-4 text-3xl font-bold tracking-tight uppercase sm:text-4xl"
      >
        Launching {RELEASE_LABEL}
      </h2>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-white/60">
        Countdown to launch day, where the state of Leonida opens up to players
        worldwide.
      </p>

      <div
        id="countdown"
        aria-hidden="true"
        class="mt-8 grid grid-cols-4 gap-3 sm:gap-4"
      >
        {
          units.map(({ id, label }) => (
            <div class="border border-white/10 bg-white/5 px-2 py-4 text-center">
              <span
                id={id}
                class="block font-mono text-2xl tabular-nums sm:text-3xl"
              >
                --
              </span>
              <span class="mt-1 block text-[10px] tracking-[0.2em] text-white/40 uppercase">
                {label}
              </span>
            </div>
          ))
        }
      </div>

      <p id="countdown-status" role="status" class="sr-only"></p>
    </div>

    <div>
      <p class="text-xs font-semibold tracking-[0.3em] text-pink-300 uppercase">
        Platforms
      </p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight uppercase sm:text-4xl">
        Where you can play
      </h2>

      <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          platforms.map(({ name, Icon }) => (
            <li class="group relative isolate flex flex-col items-center justify-center gap-5 overflow-hidden border border-white/10 bg-neutral-950 bg-gradient-to-b from-white/[0.05] to-transparent px-6 py-10 text-center transition-colors duration-500 hover:border-pink-400/50">
              {/* Neon trim on top, echoing the pink-to-amber gradient of the GTA VI mark. */}
              <span
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-pink-400 to-transparent opacity-70"
              />
              {/* Warm glow that lights up on hover. */}
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -bottom-14 left-1/2 h-24 w-44 -translate-x-1/2 rounded-full bg-pink-500/20 blur-3xl transition-colors duration-500 group-hover:bg-pink-400/40"
              />
              <Icon
                class="relative h-6 w-auto text-white transition-transform duration-500 group-hover:scale-105"
                aria-hidden="true"
              />
              <span class="relative text-[10px] font-semibold tracking-[0.3em] text-white/45 uppercase transition-colors duration-500 group-hover:text-white/70">
                {name}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="mt-4 text-xs leading-relaxed text-white/40">
        Available on both platforms at launch — {RELEASE_LABEL}. Availability as
        announced by Rockstar Games.
      </p>
    </div>
  </div>
</section>

<script define:vars={{ RELEASE_DATE }}>
  const root = document.getElementById("countdown")
  const status = document.getElementById("countdown-status")

  const days = document.getElementById("countdown-days")
  const hours = document.getElementById("countdown-hours")
  const minutes = document.getElementById("countdown-minutes")
  const seconds = document.getElementById("countdown-seconds")

  if (root && days && hours && minutes && seconds) {
    const target = new Date(RELEASE_DATE).getTime()
    const pad = (value, length = 2) => String(value).padStart(length, "0")

    const render = () => {
      const remaining = target - Date.now()

      if (remaining <= 0) {
        days.textContent = "0"
        hours.textContent = "00"
        minutes.textContent = "00"
        seconds.textContent = "00"
        if (status) {
          status.textContent = "Grand Theft Auto VI is available now."
        }
        window.clearInterval(timer)
        return
      }

      const total = Math.floor(remaining / 1000)
      days.textContent = pad(Math.floor(total / 86400), 3)
      hours.textContent = pad(Math.floor((total % 86400) / 3600))
      minutes.textContent = pad(Math.floor((total % 3600) / 60))
      seconds.textContent = pad(total % 60)
    }

    const timer = window.setInterval(render, 1000)
    render()
  }
</script>
